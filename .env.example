# 复制此文件为 .env.local 并填入真实值，.env.local 已加入 .gitignore

# ============== LLM 配置 ==============
# 用于主观题自动评分。可以是 Anthropic 官方或任何 Anthropic 协议兼容接口
# 示例 1：Anthropic 官方
#   ANTHROPIC_API_KEY=sk-ant-xxx
#   ANTHROPIC_BASE_URL=https://api.anthropic.com
# 示例 2：智谱 GLM（通过 Anthropic 兼容接口）
#   ANTHROPIC_API_KEY=xxx.xxx (智谱的 API Key)
#   ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# ============== 管理员密码 ==============
# 访问 /admin/* 需要此密码。同时用作 cookie HMAC 签名密钥
ADMIN_PASSWORD=

# ============== Redis ==============
# 默认指向本机 Redis。生产环境请用独立实例或云托管
REDIS_URL=redis://127.0.0.1:6379

# ============== 服务 ==============
PORT=18888
NODE_ENV=production
